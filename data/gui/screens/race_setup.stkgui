<?xml version="1.0" encoding="UTF-8"?>
<stkgui>
    <div x="2%" y="1%" width="96%" height="98%" layout="vertical-row" >
        <spacer height="2%" width="25"/>
        <icon width="82%" height="30%" icon="gui/icons/logo_slim.png" align="center"/>
        <header height="10%" width="90%" text="Escolha a velocidade" align="center" text_align="center" />
        <tiny-header width="100%" text="50, 100 ou 150 cilindradas" align="center" text_align="center" />
        <spacer height="4%" width="25"/>
        <box width="100%" proportion="5" padding="10" layout="vertical-row">
            <spacer height="12%" width="25"/>
            <ribbon x="2%" y="15%" id="difficulty" height="76%" width="96%" align="center">
                <icon-button id="novice" width="156" height="156" icon="gui/icons/speed_50.png"
                        text="50 cc"/>
                <icon-button id="intermediate" width="156" height="156" icon="gui/icons/speed_100.png"
                        text="100 cc"/>
                <icon-button id="expert" width="156" height="156" icon="gui/icons/speed_150.png"
                        text="150 cc"/>
            </ribbon>
        </box>
        <label width="100%" height="6%" text="Desenvolvido por Wagner Junior" align="center" text_align="center"/>
    </div>

    <icon-button id="back" x="1%" y="0" height="9%" icon="gui/icons/back.png"/>
</stkgui>
